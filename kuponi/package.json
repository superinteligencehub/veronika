{
  "name": "kuponi-lv",
  "version": "0.1.0",
  "private": true,
  "description": "Kuponi LV — купоны и акции магазинов Латвии в одном PWA",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "scrape": "node scrapers/run.js",
    "scrape:one": "node scrapers/run.js --only",
